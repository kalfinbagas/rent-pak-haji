#  v2.0: Tambah CONN_CORPORATE untuk B2B Service (SERA adaptation)
# ═══════════════════════════════════════════════════════════════

# PostgreSQL
POSTGRES_USER=rpk_admin
POSTGRES_PASSWORD=RpkSecure2026!

# Redis
REDIS_PASSWORD=RpkRedis2026!

# RabbitMQ
RABBITMQ_USER=rpk_admin
RABBITMQ_PASSWORD=RpkSecure2026!

# pgAdmin
PGADMIN_EMAIL=kalfinbagas@gmail.com
PGADMIN_PASSWORD=admin123

# Connection Strings (.NET services)
CONN_MASTER=Host=localhost;Port=5432;Database=rpk_master;Username=rpk_admin;Password=RpkSecure2026!
CONN_VEHICLE=Host=localhost;Port=5432;Database=rpk_vehicle;Username=rpk_admin;Password=RpkSecure2026!
CONN_DRIVER=Host=localhost;Port=5432;Database=rpk_driver;Username=rpk_admin;Password=RpkSecure2026!
CONN_BOOKINGORDER=Host=localhost;Port=5432;Database=rpk_bookingorder;Username=rpk_admin;Password=RpkSecure2026!
CONN_JOURNEY=Host=localhost;Port=5432;Database=rpk_journey;Username=rpk_admin;Password=RpkSecure2026!
CONN_PAYMENT=Host=localhost;Port=5432;Database=rpk_payment;Username=rpk_admin;Password=RpkSecure2026!
CONN_SAGA=Host=localhost;Port=5432;Database=rpk_saga;Username=rpk_admin;Password=RpkSecure2026!
CONN_NOTIFICATION=Host=localhost;Port=5432;Database=rpk_notification;Username=rpk_admin;Password=RpkSecure2026!
CONN_VOUCHER=Host=localhost;Port=5432;Database=rpk_voucher;Username=rpk_admin;Password=RpkSecure2026!

# Connection Strings (NestJS services)
CONN_MASTER_NEST=postgresql://rpk_admin:RpkSecure2026!@localhost:5432/rpk_master
CONN_VOUCHER_NEST=postgresql://rpk_admin:RpkSecure2026!@localhost:5432/rpk_voucher
CONN_NOTIFICATION_NEST=postgresql://rpk_admin:RpkSecure2026!@localhost:5432/rpk_notification

# Redis
REDIS_URL=localhost:6379,password=RpkRedis2026!

# RabbitMQ
RABBITMQ_URL=amqp://rpk_admin:RpkSecure2026!@localhost:5672

# Observability
SEQ_URL=http://localhost:5341
JAEGER_ENDPOINT=http://localhost:4317

# MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883
